# Copy to .env and adjust. Read by docker compose.
# Prod-like defaults; compose.override.yml switches the dev containers to local + debug.
APP_ENV=production
APP_DEBUG=false
# Filled in by `npm run setup` (or: docker compose run --rm api php artisan key:generate --show)
APP_KEY=
APP_URL=http://localhost:8000

DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app

API_PORT=8000
WEB_PORT=3000
DB_PORT_HOST=54329
NEXT_PUBLIC_API_URL=http://localhost:8000

# off | debug | develop,debug  (dev only)
XDEBUG_MODE=off

# Enrichment coordinator
QUEUE_CONNECTION=database
ENRICHMENT_LEASE_TTL_SECONDS=300
ENRICHMENT_DEFAULT_DAILY_QUOTA=10
CORS_ALLOWED_ORIGINS=http://localhost:3000
