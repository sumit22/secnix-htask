{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://secnix.local/contracts/lookup-view.schema.json",
  "title": "LookupView",
  "description": "A lookup request and its lease, as returned by every /lookups endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "indicator", "provider", "requested_by", "deduplicated", "lease", "queue", "result", "created_at", "completed_at", "expired_at", "server_time"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "status": { "$ref": "enums.schema.json#/definitions/LookupStatus" },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "$ref": "enums.schema.json#/definitions/IndicatorType" },
        "value": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "provider": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "format": "uuid" },
    "deduplicated": { "type": "boolean" },
    "lease": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["leased_at", "expires_at"],
          "properties": {
            "leased_at": { "$ref": "#/definitions/Timestamp" },
            "expires_at": { "$ref": "#/definitions/Timestamp" }
          }
        }
      ]
    },
    "queue": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["position"],
          "properties": { "position": { "type": "integer", "minimum": 1 } }
        }
      ]
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "score", "malware_families", "looked_up_at"],
          "properties": {
            "verdict": { "$ref": "enums.schema.json#/definitions/Verdict" },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "malware_families": { "type": "array", "items": { "type": "string" } },
            "looked_up_at": { "$ref": "#/definitions/Timestamp" }
          }
        }
      ]
    },
    "created_at": { "$ref": "#/definitions/Timestamp" },
    "completed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Timestamp" }] },
    "expired_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Timestamp" }] },
    "server_time": { "$ref": "#/definitions/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "leased" } } },
      "then": { "properties": { "lease": { "type": "object" } } },
      "else": { "properties": { "lease": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "queued" } } },
      "then": { "properties": { "queue": { "type": "object" } } },
      "else": { "properties": { "queue": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "result": { "type": "object" }, "completed_at": { "type": "string" } } },
      "else": { "properties": { "result": { "type": "null" }, "completed_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "expired" } } },
      "then": { "properties": { "expired_at": { "type": "string" } } },
      "else": { "properties": { "expired_at": { "type": "null" } } }
    }
  ],
  "definitions": {
    "Timestamp": { "type": "string", "format": "date-time" }
  }
}
